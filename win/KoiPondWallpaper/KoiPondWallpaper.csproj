<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>koi-pond-wallpaper</AssemblyName>
    <RootNamespace>KoiPondWallpaper</RootNamespace>
    <Version>0.3.3</Version>
    <InformationalVersion>0.3.3</InformationalVersion>
    <Authors>cnwinds</Authors>
    <Product>锦鲤池 / Koi Pond Wallpaper</Product>
    <Description>Zen koi pond live wallpaper for Windows.</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>
</Project>
